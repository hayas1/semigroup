        TaggedAnnotated {
            value: crate::Annotated::new(self.value, annotation.clone()),
            count: crate::Annotated::new(self.count, annotation.clone()),
        }
    }
}
#[automatically_derived]
impl<T, B> From<TaggedAnnotated<T, B>> for Tagged<T> {
    fn from(annotated: TaggedAnnotated<T, B>) -> Self {
