#[derive(Debug, Clone, PartialEq)]
pub struct TaggedAnnotated<T, B> {
    pub value: crate::Annotated<T, B>,
    pub count: crate::Annotated<u32, B>,
}
#[automatically_derived]
impl<T, B: Clone> crate::Semigroup for TaggedAnnotated<T, B>
where
    T: Semigroup + Clone,
{
    fn op_assign(base: &mut Self, other: Self) {
        use crate::SelectiveOp;
        use crate::SemigroupOp;
        {
            let __selected_value = <T as crate::Selective>::select(
                base.value.value(),
                other.value.value(),
            );
            let (__other_value_val, __other_value_ann) = other.value.into_parts();
            crate::Semigroup::op_assign(base.value.value_mut(), __other_value_val);
            if let crate::Selected::Other = __selected_value {
                *base.value.annotation_mut() = __other_value_ann;
            }
        }
        {
            let __selected_count = semigroup::op::Sum::lift_select(
                base.count.value(),
                other.count.value(),
            );
            let (__other_count_val, __other_count_ann) = other.count.into_parts();
            semigroup::op::Sum::lift_op_assign(
                base.count.value_mut(),
                __other_count_val,
            );
            if let crate::Selected::Other = __selected_count {
                *base.count.annotation_mut() = __other_count_ann;
            }
        }
    }
}
