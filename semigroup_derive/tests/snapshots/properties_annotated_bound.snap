/// A semigroup struct that keeps the annotation of the selected value.
/// # Properties
/// <!-- properties start -->
///|       | [`crate::Annotate`] | [`crate::Monoid`] | [`crate::Commutative`] |
///|-------|---------------------|-------------------|------------------------|
///|  impl |          ✅         |         ❌        |           ❌           |
///| where |      `T: Clone`     |                   |                        |
///<!-- properties end -->
#[derive(Semigroup, AnnotateFields)]
#[semigroup(bound(annotated = "T: Clone"), crate = crate)]
pub struct Config<T> {
    pub value: T,
}
